-docker rm "$C" >/dev/null
-docker images "$TAG"
+run() { nice -n 19 "$SCRIPTS/ctr.sh" -r "$RECIPE/patches:/mnt/patches" -r "$SRC/sfxnz-recipe/docker/patch:/mnt/patch" \
