-  -v "$RECIPE/docker/patch":/mnt/patch:ro -v "$REPO/patches":/mnt/patches:ro "$BASE" -lc '
-set -euxo pipefail
+source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
+JOBS=${MAX_JOBS:-8}
 VP=/usr/local/lib/python3.12/dist-packages
-cp -r /mnt/patch /opt/dsv41-patch
-apt-get update && apt-get install -y --no-install-recommends git patch libcusparse-dev-13-0 libcusolver-dev-13-0
-cd $VP && for p in sm120-thor-fixes v41-engram-post-lifetime pr59585-dsml-finite-args pr61039-length-aware-candidate-blocks \
-    pr61142-dsml-drifted-openers pr60792-v41-image-order; do patch -p1 --forward --no-backup-if-mismatch < /mnt/patches/vllm/$p.diff; done
-find $VP/vllm -name __pycache__ -prune -exec rm -rf {} +
-python3 -c "import vllm.models.deepseek_v41.decoder_replay_layers, vllm.models.deepseek_v41.attention, vllm.models.deepseek_v41.common.engram, vllm.models.deepseek_v41.nvidia.model, vllm.models.deepseek_v41.nvidia.flashinfer_sparse, vllm.parser.deepseek_v4, vllm.parser.deepseek_v41; print(\"vllm patches ok\")"
-git clone https://github.com/vcruz305/vllm-exl3.git /opt/vllm-exl3 && git -C /opt/vllm-exl3 checkout "$VLLM_EXL3_REF"
-cd /opt/vllm-exl3 && patch -p1 < /mnt/patches/vllm-exl3/exl3-thor.patch
-python3 /opt/dsv41-patch/fix_vllm_exl3_setup.py /opt/vllm-exl3/setup.py
-VLLM_EXL3_NO_CUDA=1 python3 -m pip install --no-build-isolation --no-deps /opt/vllm-exl3
-python3 -c "import vllm_exl3; print(\"vllm_exl3 ok\")"
-git clone https://github.com/turboderp-org/exllamav3.git /opt/exllamav3 && git -C /opt/exllamav3 checkout "$EXLLAMAV3_REF"
-TORCH_CUDA_ARCH_LIST=12.0a python3 -m pip install --no-build-isolation --no-deps /opt/exllamav3
-python3 -c "import torch, exllamav3, exllamav3_ext; assert hasattr(exllamav3_ext, \"exl3_moe\"); print(\"exllamav3 ok\")"
-rm -rf /opt/exllamav3 /opt/vllm-exl3 /var/lib/apt/lists/*'
