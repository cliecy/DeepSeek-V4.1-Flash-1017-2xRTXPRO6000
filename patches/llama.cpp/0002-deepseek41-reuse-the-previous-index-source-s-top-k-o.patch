From 5e41876353997b182c2b58043add944b6e6a1641 Mon Sep 17 00:00:00 2001
From: cliecy <cliecy@users.noreply.github.com>
Date: Sun, 18 Oct 2026 13:09:38 +0900
Subject: [PATCH 2/7] deepseek41 : reuse the previous index source's top-k on
 reader layers

Only index-source layers built a top-k; every other compressed layer kept
top_k == nullptr and fell back to the full causal mask over the compressed
rows. The reference (Attention._compress_topk_idxs) has non-source layers
take the source's indices. The two agree only while a source holds at most
index_topk compressed rows (~1K tokens on the ratio-2 layers, 512 on the
ratio-1 layers); past that 30 layers attended densely, which is both a
divergence from the reference and a cost that grows with context.

Carry the most recent index source's top-k through the layer loop and
assert that every compressed layer has one.

Suggested-by: nicholasshirley (diff and analysis in the #28696 thread)
---
 src/models/deepseek41.cpp | 15 +++++++++++----
 src/models/models.h       |  1 +
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/models/deepseek41.cpp b/src/models/deepseek41.cpp
index d0521ce98..91849bd52 100644
--- a/src/models/deepseek41.cpp
+++ b/src/models/deepseek41.cpp
@@ -599,6 +599,7 @@ ggml_tensor * llama_model_deepseek41::graph::build_attention_v41(
         llm_graph_input_dsv4 * inp_dsv4,
         ggml_tensor * cur,
         ggml_tensor * inp_pos,
+        ggml_tensor * & top_k_carry,
         int il) const {
     const auto & layer = model.layers[il];
     llm_graph_input_dsv4_raw * inp_attn = inp_dsv4->get_raw();
@@ -745,11 +746,14 @@ ggml_tensor * llama_model_deepseek41::graph::build_attention_v41(
                     ctx0, persist_score, inp_comp.state_persist_dst_idxs, il));
     }
 
-    // an index source picks the positions; the layers in between reuse what it picked
-    ggml_tensor * top_k = nullptr;
+    // an index source picks the positions; the layers in between reuse what it picked. Without
+    // the carry a reusing layer would fall back to the full causal mask and attend to every
+    // compressed row, which matches the reference only while a source has <= index_topk rows.
     if (hparams.dsv41_is_index_source(il)) {
-        top_k = build_indexer_top_k(model, inp_dsv4, inp_comp, qr, cur, inp_pos, il);
+        top_k_carry = build_indexer_top_k(model, inp_dsv4, inp_comp, qr, cur, inp_pos, il);
     }
+    GGML_ASSERT(top_k_carry && "a compressed layer needs the top-k of an earlier index source");
+    ggml_tensor * top_k = top_k_carry;
 
     ggml_tensor * k_rot = inp_attn->self_k_rot;
     if (k_rot) {
@@ -828,6 +832,9 @@ llama_model_deepseek41::graph::graph(const llama_model & model, const llm_graph_
             ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hc - 1, n_tokens), 0.0f), 0);
     cb(pre_mix, "hc_pre_init", -1);
 
+    // the positions picked by the most recent index source, reused by the layers that follow it
+    ggml_tensor * top_k_carry = nullptr;
+
     for (int il = 0; il < n_layer; ++il) {
         if ((size_t) il < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[il]) {
             res->t_layer_inp[il] = dsv41_hc_mean(ctx0, inpL);
@@ -859,7 +866,7 @@ llama_model_deepseek41::graph::graph(const llama_model & model, const llm_graph_
         cur = build_norm(cur, model.layers[il].attn_norm, nullptr, LLM_NORM_RMS, il);
         cb(cur, "attn_norm", il);
 
-        cur = build_attention_v41(model, inp_dsv4, cur, inp_pos, il);
+        cur = build_attention_v41(model, inp_dsv4, cur, inp_pos, top_k_carry, il);
 
         inpL = build_hc_post(cur, residual, post, comb, il);
         cb(inpL, "hc_attn_post", il);
diff --git a/src/models/models.h b/src/models/models.h
index 7a88b992a..ffc78fb43 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -1432,6 +1432,7 @@ struct llama_model_deepseek41 : public llama_model_deepseek4 {
                 llm_graph_input_dsv4 * inp_dsv4,
                 ggml_tensor * cur,
                 ggml_tensor * inp_pos,
+                ggml_tensor * & top_k_carry,
                 int il) const;
     };
 
